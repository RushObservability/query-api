{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rush query v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "signal",
    "operation",
    "time_range"
  ],
  "properties": {
    "version": {
      "const": "v1"
    },
    "signal": {
      "enum": [
        "logs",
        "spans",
        "metrics"
      ]
    },
    "operation": {
      "type": "string"
    },
    "time_range": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "filters": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "field",
          "op",
          "value"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "not": {
              "const": "tenant_id"
            }
          },
          "op": {
            "enum": [
              "=",
              "!=",
              ">",
              ">=",
              "<",
              "<=",
              "LIKE",
              "NOT LIKE",
              "IN",
              "NOT IN"
            ]
          },
          "value": {
            "oneOf": [
              {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "search": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "options": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "signal": {
          "const": "spans"
        },
        "operation": {
          "const": "search"
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "cursor": {
              "type": [
